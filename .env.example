# This is a static-export site (output -> ./out, deployed to Cloudflare Workers),
# so NEXT_PUBLIC_* values are inlined at BUILD TIME. Set these in the CI/build
# environment (or a local .env.production.local before `next build`), not as
# runtime secrets.

# NeetoChat live-chat widget. Paste the exact snippet from
# NeetoChat -> Settings -> Installation -> "installation script". Leave unset
# to keep the site as-is (no widget renders).
NEXT_PUBLIC_NEETOCHAT_EMBED_SNIPPET=

# NeetoForm contact form. Paste the exact snippet from a form's
# Share -> Embed on a webpage -> Inline embed. Leave unset and the site falls
# back to the existing mailto: contact form.
NEXT_PUBLIC_NEETOFORM_EMBED_SNIPPET=
